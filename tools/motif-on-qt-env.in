#!/bin/sh
# Build Motif programs against Motif on Qt.
#
#   eval "$(motif-on-qt-env)"      set CPPFLAGS, LDFLAGS and PKG_CONFIG_PATH
#   motif-on-qt-env make ...       run one command with them set
#
# Headers come from @MQ_INCLUDEDIR@ and -lXm -lXt -lX11 (and pkg-config
# x11, xt, motif) resolve to Motif on Qt, linked statically.
libdir="@MQ_LIBDIR@"
includedir="@MQ_INCLUDEDIR@"
cppflags="-I$includedir${CPPFLAGS:+ $CPPFLAGS}"
ldflags="-L$libdir${LDFLAGS:+ $LDFLAGS}"
pcpath="$libdir/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
if [ $# -eq 0 ]; then
  printf 'export CPPFLAGS="%s"\n' "$cppflags"
  printf 'export LDFLAGS="%s"\n' "$ldflags"
  printf 'export PKG_CONFIG_PATH="%s"\n' "$pcpath"
  exit 0
fi
CPPFLAGS="$cppflags" LDFLAGS="$ldflags" PKG_CONFIG_PATH="$pcpath" exec "$@"
